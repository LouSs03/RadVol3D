# Copia este archivo como .env y rellena los valores.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
STORAGE_BUCKET=

# Modelos (opcionales). Si falta alguna, el modelo correspondiente queda no
# disponible, pero la aplicacion arranca igual y lo informa al iniciar.
# MODEL_BUCKET es el bucket privado con los pesos; *_WEIGHTS_OBJECT es la ruta del
# .pth dentro de ese bucket. MODEL_CACHE_DIR (por omision .cache/models) guarda la
# copia local. RECONSTRUCTION_STRATEGY elige la reconstruccion (por omision en1).
MODEL_BUCKET=
EN1_WEIGHTS_OBJECT=
EN2_WEIGHTS_OBJECT=
MODEL_CACHE_DIR=
RECONSTRUCTION_STRATEGY=
