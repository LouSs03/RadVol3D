# Copia este archivo como .env y rellena los valores.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
STORAGE_BUCKET=

# Modelos (opcionales). Si falta alguna, el modelo correspondiente queda no
# disponible, pero la aplicacion arranca igual y lo informa al iniciar.
# MODEL_BUCKET es el bucket privado con los pesos; *_WEIGHTS_OBJECT es la ruta del
# .pth dentro de ese bucket. MODEL_CACHE_DIR (por omision .cache/models) guarda la
# copia local. RECONSTRUCTION_STRATEGY elige la reconstruccion (por omision en1).
MODEL_BUCKET=
EN1_WEIGHTS_OBJECT=
EN2_WEIGHTS_OBJECT=
MODEL_CACHE_DIR=
RECONSTRUCTION_STRATEGY=

# Modo de una radiografia (opcional). Servicio externo AXON (Colab + ngrok) que
# reconstruye un volumen desde un DICOM de torax. Sin estas dos variables el modo
# queda "no disponible" y el de cuatro proyecciones funciona igual. La clave la entrega
# Lourdes por un medio privado: nunca la subas al repositorio ni la pegues en un chat.
# Para probar sin el servicio real: python scripts/axon_mock_server.py (ver su ayuda).
AXON_URL=
AXON_API_KEY=
# Opcionales: cada cuantos segundos se consulta el trabajo y cuanto se espera como
# maximo (por omision 5 y 900).
AXON_POLL_SECONDS=
AXON_MAX_WAIT_SECONDS=
