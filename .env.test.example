# Copia este archivo como .env.test y rellena los valores.
#
# Las pruebas de integracion leen SOLO este archivo, nunca .env.
# Debe apuntar a un proyecto de Supabase DE PRUEBA con el esquema de
# docs/database/schema/001_create_tables.sql aplicado y su bucket creado.
# Nunca apuntes aqui al proyecto real: las pruebas crean y borran datos.

DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=

# Modelos (opcionales). Si falta alguna, el modelo correspondiente queda no
# disponible, pero la aplicacion arranca igual y lo informa al iniciar.
# MODEL_BUCKET es el bucket privado con los pesos; *_WEIGHTS_OBJECT es la ruta del
# .pth dentro de ese bucket. MODEL_CACHE_DIR (por omision .cache/models) guarda la
# copia local. RECONSTRUCTION_STRATEGY elige la reconstruccion (por omision en1).
MODEL_BUCKET=
EN1_WEIGHTS_OBJECT=
EN2_WEIGHTS_OBJECT=
MODEL_CACHE_DIR=
RECONSTRUCTION_STRATEGY=
